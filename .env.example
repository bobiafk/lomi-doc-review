# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://lomi:lomi@localhost:25432/lomi
REDIS_URL=redis://localhost:26379
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
