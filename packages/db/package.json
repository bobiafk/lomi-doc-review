{
  "name": "@lomi/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "node dist/bin/seed.js"
  },
  "dependencies": {
    "@lomi/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@lomi/config": "workspace:*",
    "@types/node": "22.20.6",
    "@types/pg": "8.23.1",
    "eslint": "10.15.0",
    "prisma": "7.10.1",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
